# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets / local machine config — never commit
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist

# Backend (Cloudflare Worker) / Admin Web
backend/node_modules/
backend/.wrangler/
backend/dist/
admin/node_modules/
admin/dist/
admin/.wrangler/
*.sqlite
*.sqlite-journal
# Wrangler's real local secrets file - .dev.vars.example below stays tracked.
.dev.vars
!.dev.vars.example

# Supabase CLI local link/cache state (project ref, pooler URL, version
# pins) - machine-local, never committed, mirrors backend/.wrangler/ above.
supabase/.temp/
supabase/.branches/

# Claude Code personal/local permission overrides - machine-local, never
# committed (shared settings would belong in .claude/settings.json instead).
.claude/settings.local.json
