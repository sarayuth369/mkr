{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mkr-web-real",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "build/web",
        "-p",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "minvest-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "minvest/tools/mock-upstream.mjs",
        "--excel",
        "minvest/data/normalized.json",
        "--demo-income"
      ],
      "port": 8799
    },
    {
      "name": "minvest-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "minvest",
        "run",
        "dev",
        "--",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}