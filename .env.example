# MKR (Market Radar) — Flutter build-time configuration reference.
#
# This project does NOT read a .env file at runtime — there is no
# flutter_dotenv dependency. Every value below is consumed via
# `--dart-define=KEY=value` (see lib/core/config/*.dart, all built on
# String.fromEnvironment). This file exists purely as a single place
# documenting every define the app understands and what each one does —
# copy the values you need into your actual `flutter run`/`flutter build`
# command or your CI's build step.
#
# CLIENT-SAFE values only. Never put a secret key here or in a dart-define —
# anything passed via --dart-define is compiled into the APK and can be
# extracted. Backend-only secrets (SUPABASE_SERVICE_ROLE_KEY, FCM
# credentials, TWELVE_DATA_API_KEY) belong in backend/.dev.vars /
# `wrangler secret put`, never here. See docs/MKR-EXTERNAL-INTEGRATIONS.md.

# ── Market data (Phase 1/2 — lib/features/markets/data/market_data_config.dart) ──
# demo (default) never calls a backend; real requires MARKET_BACKEND_BASE_URL.
MARKET_DATA_MODE=demo
MARKET_BACKEND_BASE_URL=https://mkr-backend.biz2success.workers.dev
MARKET_SECONDARY_ENABLED=false

# ── Ads (lib/features/ads/domain/ad_config.dart) ──
MKR_ADS_ENABLED=true
MKR_ADS_TEST_MODE=true

# ── Supabase (Phase 2.2 — lib/core/config/supabase_config.dart) ──
# Both required together to enable auth/watchlist-sync/alerts-cloud-sync/
# device registration; the app works fully without them (guest mode, local
# watchlist/alerts, no cloud sync) — see docs/MKR-EXTERNAL-INTEGRATIONS.md.
# SUPABASE_ANON_KEY is the public/publishable key — safe for a client build,
# NOT the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Example full command once Supabase is configured:
#   flutter build apk --dart-define=MARKET_DATA_MODE=real \
#     --dart-define=MARKET_BACKEND_BASE_URL=https://mkr-backend.biz2success.workers.dev \
#     --dart-define=SUPABASE_URL=https://<project>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<anon-key>
