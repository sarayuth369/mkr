<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Firebase Cloud Messaging (MKR Firebase FCM Integration Task) -
         runtime-requested on Android 13+ via FirebaseMessaging.requestPermission()
         (see lib/features/push/data/firebase_push_notification_service.dart);
         a no-op declaration on older Android versions, where notifications
         are allowed by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Market Radar"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <!-- 2026-09-18 Closed Testing launch-crash fix - root cause confirmed
             via adb logcat on a real launch: com.google.android.gms:play-
             services-ads-api (pulled in by google_mobile_ads) transitively
             depends on androidx.work, whose ContentProvider-based
             WorkManagerInitializer runs EAGERLY at Application startup -
             before MainActivity, the Flutter engine, or any Dart code
             (including main.dart's runZonedGuarded/try-catch) ever runs. On
             a device where Google Play services is behind what
             play-services-ads-api expects (confirmed via logcat:
             "GooglePlayServicesUtil: Google Play services out of date" right
             before the fatal exception), that eager init throws and takes
             down the ENTIRE process before the app ever shows a frame - no
             app-level try/catch can run early enough to prevent it. Nothing
             in this app (no `workmanager` plugin, no direct androidx.work
             usage) needs WorkManager to be ready at process start - the ads
             SDK only uses it lazily for non-critical background telemetry.
             Disabling this eager auto-init (Google's own documented
             "on-demand initialization" workaround for WorkManager - see
             androidx.work.Configuration.Provider docs) makes any future
             WorkManager use lazy instead,
             so a failure there can no longer crash startup - it is
             contained to whatever Dart code path actually needed it
             (already guarded, e.g. _initializeAdsAndGetConsent's try/catch
             around MobileAds.instance.initialize()). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase email-confirmation (and future magic-link/OAuth)
                 callback. Must match mkrAuthCallbackUrl in
                 lib/core/deeplink/auth_callback.dart exactly, and must also
                 be added to Supabase Dashboard -> Authentication -> URL
                 Configuration -> Redirect URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mkr" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 2026-09-17 AdMob + Billing task - the real MKR AdMob Application
             ID (matches AdConfig.androidAppId in Dart, kept there only for
             admin/diagnostic display). Not a secret - Google's own AdMob
             integration docs require this exact value hardcoded here; it
             identifies the app to AdMob, it does not authenticate anything.
             Ad UNIT selection (test vs real) is a separate, runtime-gated
             concern (AdConfig.testMode) - this App ID stays the same either
             way, per Google's documented test-ads guidance. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1918372113970166~1172227772"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 2026-09-17 Hosted Privacy Policy task - required for url_launcher's
             launchUrl(..., mode: LaunchMode.externalApplication) to find a
             browser on Android 11+ package-visibility rules; without this the
             package manager query silently returns nothing and launchUrl
             falls through to this app's own coded fallback for every device,
             not just ones genuinely missing a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
