{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "isolatedModules": true, "resolveJsonModule": true, "allowJs": false
  },
  "include": ["src/**/*.ts"]
}
